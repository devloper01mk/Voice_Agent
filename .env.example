# Database (SQLite local dev — set PostgreSQL URL in production)
DATABASE_URL=file:./dev.db

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174,http://localhost:5173

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound phone via Simulator 2.0 agent-v2 (recommended). Create trunk in LiveKit Cloud → SIP.
# LIVEKIT_SIP_OUTBOUND_TRUNK=ST_xxxxxxxx
# LIVEKIT_SIP_FROM_NUMBER=9198xxxxxxxx

# Agent noise cancellation: nc | bvc | off (default: bvc)
NOISE_CANCELLATION=bvc

# Azure Speech (STT) — default STT provider in Agent Studio
# Phone AutoDetect (en-IN + hi-IN) needs Standard S0. F0 falls back to one locale.
# Set AZURE_SPEECH_LID=0 to skip AutoDetect on phone STT.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_ENDPOINT=https://centralindia.api.cognitive.microsoft.com/

# Sarvam Saaras STT (Indian languages + Hinglish code-mix) — Agent Studio STT provider
SARVAM_API_KEY=

# Google Cloud Speech v2 STT (Chirp) — Agent Studio STT provider
# Service account JSON path; enable Speech-to-Text API on the project
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Regional endpoint for Chirp (India: asia-south1)
GOOGLE_SPEECH_LOCATION=asia-south1

# LLM — per-agent provider in Studio: groq | gpt
# OPENAI_API_KEY is also required when an agent uses OpenAI STT or Simulator S2S (openai_realtime)
OPENAI_API_KEY=
# Gemini Live S2S (Simulator 2.0 + LiveKit SIP phone + legacy Acefone telephony)
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Simulator 2.0 S2S only (Studio Voice → openai_realtime, or Simulator session override)
# Force S2S preset uses gpt-realtime-mini via SIMULATOR_FORCE_S2S_PRESET (see packages/shared)
# OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Fallback only if an agent has no llmModel. Phone + Simulator 2.0 use Agent Studio LLM.
OPENAI_SIMULATOR2_MODEL=gpt-5.4-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# STT — per-agent provider in Studio: azure | openai | sarvam | google
# OpenAI STT models: gpt-4o-mini-transcribe | gpt-4o-transcribe | whisper-1 | gpt-realtime-whisper
# Google STT models: chirp_3 | chirp_2 | long | telephony (selected per agent in Agent Studio → STT tab)

# Cartesia (TTS) — per-agent model in Studio; CARTESIA_MODEL_ID is fallback for new agents
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.6
# Phone TTS: wait this long for Cartesia SSE headers (default 12000). India→US often exceeds 4s.
# CARTESIA_CONNECT_TIMEOUT_MS=12000

# Voice latency tuning (agent worker + phone telephony)
# low = fastest replies, more cut-offs | balanced | stable = wait for full sentences (recommended for Sarvam phone)
LATENCY_PROFILE=low
# Outbound phone: AMD listen window before opener (default 1800ms)
# TELEPHONY_AMD_TIMEOUT_MS=1800
# Use Studio greeting as opener — skips LLM on connect (default on). Set 0 for LLM opener.
# TELEPHONY_FAST_OPENER=1
# Sarvam/Google phone STT: silence after last word before turn commits (default 1100ms; 1800 recommended for Hinglish)
TELEPHONY_SEGMENT_FINAL_MS=650
# Simulator 2.0 Sarvam STT segment merge (optional; falls back to TELEPHONY_SEGMENT_FINAL_MS)
# SIMULATOR_SEGMENT_FINAL_MS=1200
# Override learnings retrieved per call (default: 3 low / 4 balanced / 5 stable)
# LEARNING_VECTOR_TOP_K=5

# Simulator 2.0 / LiveKit SIP phone use apps/agent-v2 (voice-sales-agent-v2) — run: npm run dev:agent-v2
# Legacy Acefone Voice Bot WSS still uses apps/api telephony call-session (cascaded or in-API S2S).
# Classic simulator uses apps/agent (voice-sales-agent) — run: npm run dev:agent

# Google Calendar sync (optional — in-app month calendar works without this)
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Post-call webhook (optional — fires once per terminal call)
# CALL_COMPLETED_WEBHOOK_URL=http://192.168.x.x:8000/api/projects/<project-id>/ingest/voice/call-completed
# CALL_COMPLETED_WEBHOOK_TOKEN=nxr_ingest_...   # sent as X-Nexora-Ingest-Token
# Comma-separate multiple URLs if needed
# CALL_WEBHOOK_SECRET=optional_hmac_secret_for_X-VSA-Signature_header

# Outbound voicemail detection (enabled by default on phone calls)
# TELEPHONY_VOICEMAIL_DETECTION=1
# TELEPHONY_AMD_TIMEOUT_MS=1800
# TELEPHONY_VOICEMAIL_BEEP_WAIT_MS=1500

# Short filler speech before slow tool calls (capture_demo_lead, schedule_callback, etc.)
# TELEPHONY_TOOL_HOLD=1

# Nexora live hotel inventory for Simulator 2.0 (lookup_hotel_availability tool)
# NEXORA_FACTS_QUERY_URL=http://127.0.0.1:8000/api/projects/<project-id>/intelligence/facts/query
# NEXORA_INGEST_TOKEN=nxr_ingest__...
