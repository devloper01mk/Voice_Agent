# Database — Postgres (docker compose up -d)
DATABASE_URL=postgresql://vsa:vsa@localhost:5433/voice_sales_agent

# API
API_PORT=3001
API_URL=http://localhost:3001
# Comma-separated Studio origins
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174,http://localhost:5173
# Protect /api/* and /stream when set (Bearer / X-API-Key / ?token=). Leave empty for open local dev.
API_AUTH_TOKEN=dev-local-token
# Same value for the Vite app (required when API_AUTH_TOKEN is set)
VITE_API_AUTH_TOKEN=dev-local-token

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound phone via Simulator 2.0 agent-v2 (recommended). Create trunk in LiveKit Cloud → SIP.
# LIVEKIT_SIP_OUTBOUND_TRUNK=ST_xxxxxxxx
# Caller ID must be E.164 — Tata/Smartflo rejects a From without the leading `+`.
# LIVEKIT_SIP_FROM_NUMBER=+9198xxxxxxxx

# Agent noise cancellation: nc | bvc | off (default: bvc)
NOISE_CANCELLATION=bvc

# LLM — Studio product-knowledge / brain (GPT). Voice uses Gemini Live only.
OPENAI_API_KEY=
# Gemini Live S2S — sole voice pipeline (Simulator 2.0 + LiveKit SIP + Acefone telephony)
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Fallback only if an agent has no llmModel (brain compression — not voice).
OPENAI_SIMULATOR2_MODEL=gpt-5.4-mini

# Voice latency tuning
# low = fastest replies, more cut-offs | balanced | stable
LATENCY_PROFILE=low

# Simulator 2.0 / LiveKit SIP phone use apps/agent-v2 — run: npm run dev:agent-v2
# Acefone Voice Bot WSS uses apps/api telephony (Gemini Live in-process). Set TELEPHONY_WSS_PUBLIC_URL.

# Post-call webhook (optional — fires once per terminal call)
# CALL_COMPLETED_WEBHOOK_URL=http://192.168.x.x:8000/api/projects/<project-id>/ingest/voice/call-completed
# CALL_COMPLETED_WEBHOOK_TOKEN=nxr_ingest_...
# CALL_WEBHOOK_SECRET=optional_hmac_secret_for_X-VSA-Signature_header

# Nexora live hotel inventory for Simulator 2.0
# NEXORA_FACTS_QUERY_URL=http://127.0.0.1:8000/api/projects/<project-id>/intelligence/facts/query
# NEXORA_INGEST_TOKEN=nxr_ingest__...

# Acefone / Smartflo (optional — LiveKit SIP is the preferred outbound path)
# ACEFONE_API_URL=
# ACEFONE_API_TOKEN=
# ACEFONE_CALLER_ID=
# TELEPHONY_WSS_PUBLIC_URL=wss://your-tunnel.example/stream
