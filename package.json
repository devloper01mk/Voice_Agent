{
  "name": "voice-sales-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @vsa/api",
    "dev:web": "npm run dev -w @vsa/web",
    "dev:agent": "npm run dev -w @vsa/agent",
    "dev:agent-v2": "npm run dev -w @vsa/agent-v2",
    "db:generate": "npm run db:generate -w @vsa/api",
    "db:migrate": "npm run db:migrate -w @vsa/api",
    "db:push": "npm run db:push -w @vsa/api"
  },
  "overrides": {
    "@livekit/agents": "1.5.0",
    "@livekit/agents-plugin-cartesia": "1.5.0",
    "@livekit/agents-plugin-openai": "1.5.0",
    "@livekit/agents-plugin-silero": "1.5.0"
  }
}
